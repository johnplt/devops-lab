name: devops-lab-airflow

networks:
  app-network:
    external: true

volumes:
  airflow-logs:

services:
  airflow-init:
    image: apache/airflow:{{ airflow_version }}
    container_name: airflow_init
    entrypoint: /bin/bash
    environment:
      &airflow-common-env
      AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: postgresql+psycopg2://{{ airflow_db_user }}:{{ airflow_db_password }}@{{ conteneur_name }}:5432/{{ airflow_db_name }}
      AIRFLOW__CORE__EXECUTOR: LocalExecutor
      AIRFLOW__CORE__AUTH_MANAGER: airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
      AIRFLOW__API__BASE_URL: "http://airflow.johnnyplaton.com"
      AIRFLOW_UID: "50000"
      AIRFLOW__LOGGING__BASE_LOG_FOLDER: "/opt/airflow/logs"
      # Clés indispensables en Airflow 3 pour signer et valider les tokens d'authentification inter-services :
      AIRFLOW__CORE__FERNET_KEY: "{{ airflow_fernet_key }}"
      AIRFLOW__WEBSERVER__SECRET_KEY: "{{ airflow_secret_key }}"
      # Clé secrète partagée indispensable en Airflow 3 pour signer et valider les tokens JWT de l'Execution API
      AIRFLOW__API_AUTH__JWT_SECRET: "{{ airflow_jwt_secret }}"
      _AIRFLOW_WWW_USER_CREATE: "true"
      _AIRFLOW_WWW_USER_USERNAME: "{{ airflow_admin_user }}"
      _AIRFLOW_WWW_USER_PASSWORD: "{{ airflow_admin_password }}"
      AIRFLOW__DAG_PROCESSOR__DAG_BUNDLE_CONFIG_LIST: '[{"name": "cinemind-repo", "classpath": "airflow.providers.git.bundles.git.GitDagBundle", "kwargs": {"repo_url": "https://github.com/johnplt/cinemind.git", "subdir": "dags", "tracking_ref": "main"}}]'
    command: -c "airflow db migrate && airflow users create --username {{ airflow_admin_user }} --firstname Admin --lastname User --role Admin --email admin@example.com --password {{ airflow_admin_password }} || true"
    networks:
      - app-network
    volumes:
      - airflow-logs:/opt/airflow/logs

  airflow-api-server:
    image: apache/airflow:{{ airflow_version }}
    container_name: airflow_api_server
    restart: always
    depends_on:
      - airflow-init
    environment:
      <<: *airflow-common-env
    ports:
      - "8080:8080"
    command: api-server
    networks:
      - app-network
    volumes:
      - airflow-logs:/opt/airflow/logs

  airflow-scheduler:
    image: apache/airflow:{{ airflow_version }}
    container_name: airflow_scheduler
    restart: always
    depends_on:
      - airflow-init
    environment:
      <<: *airflow-common-env
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - airflow-logs:/opt/airflow/logs
    command: scheduler
    networks:
      - app-network

  airflow-triggerer:
    image: apache/airflow:{{ airflow_version }}
    container_name: airflow_triggerer
    restart: always
    depends_on:
      - airflow-init
    environment:
      <<: *airflow-common-env
    command: triggerer
    networks:
      - app-network
    volumes:
      - airflow-logs:/opt/airflow/logs

  airflow-dag-processor:
    image: apache/airflow:{{ airflow_version }}
    container_name: airflow_dag_processor
    restart: always
    depends_on:
      - airflow-init
    environment:
      <<: *airflow-common-env
    command: dag-processor
    networks:
      - app-network
    volumes:
      - airflow-logs:/opt/airflow/logs